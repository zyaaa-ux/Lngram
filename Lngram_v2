def _canonical_surrogate_mode(mode: str) -> str:
    normalized = str(mode).strip().lower().replace("-", "_")
    if normalized in {"exact", "exact_local", "local_expectation"}:
        return "exact"
    if normalized in {"approx", "approximate", "bitflip", "bit_flip", "one_bit"}:
        return "approximate"
    raise ValueError(f"Unknown surrogate mode {mode!r}. Use 'exact' or 'approximate'.")


def _canonical_execution_mode(mode: str) -> str:
    normalized = str(mode).strip().lower()
    if normalized not in {"full", "streaming", "auto"}:
        raise ValueError(
            f"Unknown execution mode {mode!r}. Use 'full', 'streaming', or 'auto'."
        )
    return normalized


@dataclass(frozen=True)
class LngramConfig:
    enabled: bool
    target_layers: Tuple[int, ...]
    bits_per_route: int
    ngrams: Tuple[int, ...]
    memory_dim: int
    dropout: float
    q_proj_init_std_scale: float
    table_init_mode: str
    table_init_std_scale: float
    readout_num_heads: int
    readout_num_kv_heads: int
    readout_head_dim: int
    readout_attention_dropout: float
    readout_proj_bias: bool
    readout_use_sdpa: bool
    readout_online_accum_fp32: bool
    readout_checkpoint_streaming: bool
    readout_auto_max_kv_mb: float
    readout_q_proj_init_std_scale: float
    readout_kv_proj_init_std_scale: float
    output_proj_init_std_scale: float
    q_surrogate_enable: bool
    q_surrogate_mode: str
    q_surrogate_training_only: bool
    q_surrogate_temp: float
    q_surrogate_scale: float
    q_surrogate_route_chunk_size: int
    q_surrogate_accum_fp32: bool
    exact_code_chunk_size: int
    approx_counterfactual_chunk_size: int
    approx_reuse_forward_memory: bool
    approx_use_int32_indices: bool
    execution_mode: str
    stream_route_chunk_size: int
    proj_chunk_size: Optional[int]
    use_fused_rmsnorm: bool
    conv_kernel_size: int
    conv_dilation: Optional[int]
    conv_bias: bool
    conv_zero_init: bool
    table_lr_multiplier: float
    table_weight_decay: float

    def validate(
        self, hidden_size: int, num_hidden_layers: Optional[int] = None
    ) -> None:
        bits_per_route = int(self.bits_per_route)
        if bits_per_route <= 0:
            raise ValueError(f"bits_per_route must be > 0, got {bits_per_route}.")
        if bits_per_route > 16:
            raise ValueError(
                "bits_per_route > 16 is intentionally rejected because the exact counterfactual code space and n-gram tables become impractically large."
            )
        if hidden_size % bits_per_route != 0:
            raise ValueError(
                f"hidden_size={hidden_size} must be divisible by bits_per_route={bits_per_route}."
            )
        if int(self.memory_dim) <= 0:
            raise ValueError(f"memory_dim must be > 0, got {self.memory_dim}.")
        if not self.ngrams:
            raise ValueError("ngrams must not be empty.")
        if any((int(n) < 1 for n in self.ngrams)):
            raise ValueError(f"All n-gram orders must be >= 1, got {self.ngrams}.")
        if not 0.0 <= float(self.dropout) < 1.0:
            raise ValueError(f"dropout must be in [0, 1), got {self.dropout}.")
        if str(self.table_init_mode).strip().lower() not in {"zeros", "normal"}:
            raise ValueError(
                f"table_init_mode must be 'zeros' or 'normal', got {self.table_init_mode!r}."
            )
        if int(self.readout_num_heads) <= 0:
            raise ValueError("readout_num_heads must be > 0.")
        if int(self.readout_num_kv_heads) <= 0:
            raise ValueError("readout_num_kv_heads must be > 0.")
        if int(self.readout_num_heads) % int(self.readout_num_kv_heads) != 0:
            raise ValueError(
                f"readout_num_heads={self.readout_num_heads} must be divisible by readout_num_kv_heads={self.readout_num_kv_heads}."
            )
        if int(self.readout_head_dim) <= 0:
            raise ValueError("readout_head_dim must be > 0.")
        if not 0.0 <= float(self.readout_attention_dropout) < 1.0:
            raise ValueError("readout_attention_dropout must be in [0, 1).")
        if float(self.readout_auto_max_kv_mb) <= 0.0:
            raise ValueError("readout_auto_max_kv_mb must be > 0.")
        _canonical_surrogate_mode(self.q_surrogate_mode)
        _canonical_execution_mode(self.execution_mode)
        if float(self.q_surrogate_temp) < 0.0:
            raise ValueError(
                f"q_surrogate_temp must be >= 0, got {self.q_surrogate_temp}."
            )
        if int(self.q_surrogate_route_chunk_size) <= 0:
            raise ValueError("q_surrogate_route_chunk_size must be > 0.")
        if int(self.exact_code_chunk_size) <= 0:
            raise ValueError("exact_code_chunk_size must be > 0.")
        if int(self.approx_counterfactual_chunk_size) <= 0:
            raise ValueError("approx_counterfactual_chunk_size must be > 0.")
        if int(self.stream_route_chunk_size) <= 0:
            raise ValueError("stream_route_chunk_size must be > 0.")
        if self.proj_chunk_size is not None and int(self.proj_chunk_size) <= 0:
            raise ValueError("proj_chunk_size must be None or > 0.")
        if int(self.conv_kernel_size) <= 0:
            raise ValueError("conv_kernel_size must be > 0.")
        if self.conv_dilation is not None and int(self.conv_dilation) <= 0:
            raise ValueError("conv_dilation must be None or > 0.")
        if num_hidden_layers is not None:
            invalid = [
                int(idx)
                for idx in self.target_layers
                if not 0 <= int(idx) < int(num_hidden_layers)
            ]
            if invalid:
                raise ValueError(
                    f"target_layers contains out-of-range indices {invalid} for num_hidden_layers={num_hidden_layers}."
                )


